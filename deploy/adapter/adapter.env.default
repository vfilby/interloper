# Warpgate adapter settings. install.sh copies this to /opt/interpose-adapter/.env on the first install only; real
# host names go there, never in the repository.
TZ=America/Los_Angeles
# The hub's address as phones see it (the reverse proxy sends /v1/* to the hub API).
HUB_URL=https://interpose-hub.home.example
WARPGATE_URL=https://warpgate.home.example
# The adapter applies the phase-1 policy before anyone is asked: it denies what the policy denies.
ALLOWED_REQUESTERS=claude,maggy
MAX_DURATION_RW=2h
MAX_DURATION_ADMIN=2h
# Unanswered requests are DENIED at Warpgate after this (fail closed). Beside the phase-1 broker in report mode that
# is new: a request left alone longer than this can no longer be approved in Warpgate's own UI.
REQUEST_TTL=15m
