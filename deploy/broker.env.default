# Settings of the warpgate-approver broker. install.sh copies this file to /opt/warpgate-approver/broker.env the
# first time only; after that it never overwrites your broker.env. Edit that file, then:
#   cd /opt/warpgate-approver && sudo docker compose up -d
TZ=America/Los_Angeles
WARPGATE_URL=https://interloper.home.example

# report: notify, and flag what the policy would deny; deny nothing.
# enforce: deny what the policy denies (reason starts "warpgate-approver:"), deny unanswered requests after REQUEST_TTL.
POLICY_MODE=report

ALLOWED_REQUESTERS=claude,maggy
# cssh asks for 2h on every tier; lowering the admin cap alone would deny every cssh admin request
MAX_DURATION_RW=2h
MAX_DURATION_ADMIN=2h
REQUEST_TTL=15m
