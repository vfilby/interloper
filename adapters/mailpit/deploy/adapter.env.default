# Mail adapter settings. install.sh copies this to /opt/interpose-adapter-mailpit/.env on the first install only; real
# host names go there, never in the repository.
TZ=UTC
# The adapter id registered at the hub (one per Mailpit instance it guards).
ADAPTER_ID=mail
# The hub's address as phones see it (the reverse proxy sends /v1/* to the hub API).
HUB_URL=https://interpose-hub.home.example
# Mailpit's API as seen from this host (the adapter uses the host network).
MAILPIT_URL=http://127.0.0.1:8025
# The adapter's own login in Mailpit's ui-users file (MP_UI_AUTH_FILE); its password is secrets/mailpit-password.
MAILPIT_USER=interpose-adapter
# Messages tagged `held` that are older than this are left alone, so turning the adapter on does not page the whole
# backlog. Keep it longer than REQUEST_TTL.
MAX_AGE=24h
# Unanswered requests are tagged `denied` in Mailpit after this (fail closed). The message stays in Mailpit and can
# still be released by hand in its UI.
REQUEST_TTL=12h
